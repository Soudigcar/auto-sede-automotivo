{
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/autocar-follow-up-v2",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/privacy-retention",
      "schedule": "17 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/commercial-metrics-canonicalization-v1": false
    }
  }
}
