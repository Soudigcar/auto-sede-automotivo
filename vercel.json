{
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/autocar-follow-up-v2",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/privacy-retention",
      "schedule": "17 3 * * * *"
    }
  ]
}
